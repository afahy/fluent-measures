
# Get previous and current HEADs
prevHEAD=$1
newHEAD=$2
checkoutType=$3

# Git passes the null object ID (all zeros) as the previous HEAD when there was no previous
# checkout, as in `git worktree add`, and as the new HEAD for an unborn branch, as in
# `git switch --orphan`. There is nothing to diff, so skip the check.
for head in "$prevHEAD" "$newHEAD"; do
  case "$head" in
    *[!0]*) ;;
    *) exit 0 ;;
  esac
done

# Only run on branch checkout (checkoutType=1) or pull
if [ "$checkoutType" = 1 ]; then
  # Check if package.json or pnpm-lock.yaml changed between the two heads
  if git diff --name-only "$prevHEAD" "$newHEAD" | grep --quiet "^package.json\|^pnpm-lock.yaml"; then
    echo "📦 Package files changed. Running pnpm install..."
    pnpm install
  fi
fi
