#!/bin/sh
# The git hooks put this folder on PATH when pnpm isn't on it (see ../_pnpm.sh). This script runs
# `corepack pnpm`, which Node.js 24 ships. If that doesn't work, it runs `npx pnpm@<version>`, with
# the version from the packageManager field of package.json. Node.js 25 and later ship no corepack.

# A hook can't answer a prompt, so let corepack download pnpm without asking.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

if command -v corepack >/dev/null 2>&1; then
  if corepack_error=$(corepack pnpm --version 2>&1 >/dev/null); then
    exec corepack pnpm "$@"
  fi
fi

# For example, "pnpm@10.10.0" or "pnpm@10.10.0+sha512.<hash>" gives 10.10.0.
version=$(sed -n 's/^[[:space:]]*"packageManager":[[:space:]]*"pnpm@\([^"+]*\).*/\1/p' \
  "$(dirname -- "$0")/../../package.json" 2>/dev/null)

if [ -n "$version" ] && command -v npx >/dev/null 2>&1; then
  if npx_error=$(npx --yes "pnpm@$version" --version 2>&1 >/dev/null); then
    exec npx --yes "pnpm@$version" "$@"
  fi
fi

{
  echo "husky - pnpm isn't on PATH, and neither 'corepack pnpm' nor 'npx pnpm@${version:-<version>}' works."
  if [ -n "${corepack_error-}" ]; then
    echo "husky - 'corepack pnpm --version' printed:"
    echo "$corepack_error"
  fi
  if [ -n "${npx_error-}" ]; then
    echo "husky - 'npx --yes pnpm@$version --version' printed:"
    echo "$npx_error"
  fi
  echo "husky - Install pnpm ${version:-from the packageManager field of package.json} and put it on PATH: https://pnpm.io/installation"
} >&2
exit 127
