{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner", "./.github/scripts/mutation-report.mjs"],
  "mutate": ["src/**/!(*.spec|*.test).ts"],
  "reporters": ["clear-text", "progress", "mutation-json"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 99,
    "low": 98,
    "break": 98
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
